#Q1 Use the Iris dataset and plot hsitograms of Sepal length, Sepal width,
# lenth and petal with in a single plot

library(tidyverse)
library(MASS)
library(Ecdat)
library(ggplot2)

data = iris[, 1:4] # exclude species column

#data_long <- pivot_longer(names_to = "variable" , values_to = "value")
data_long = gather(data,  key = "variable", value = "value")

ggplot(data_long, aes(x = value)) +
  geom_histogram(binwidth = 0.3, color = "black", fill = "lightblue") +
  facet_wrap(~ variable, nrow = 1) + 
  labs(x = "Value", 
       y = "Freqeuncy", 
       title = "Histograms of Iris Measurements") +
  theme_classic()

#Q5 Plot UScrime data, plot crime rates over income and education

data(UScrime)
str(data)

df <- UScrime[, c("Ed", "U1", "U2", "GDP")]
df$id <- 1:nrow(df)

df_long = pivot_longer(df, 
                       cols = -id, 
                       names_to = "Variable",
                       values_to = "Value"
                       )

ggplot(df_long, aes(x = id, y = Value, color = Variable)) +
  geom_line() +
  labs(title = "Crime-related Variables by Index", x = "Index", y = "Value") +
